# ==============================================================================
# GovFlow Infrastructure Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=govflow
POSTGRES_PORT=5432
EVOLUTION_DB_NAME=evolution

# ------------------------------------------------------------------------------
# 2. MinIO (S3 Object Storage) Configuration
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_EVOLUTION_BUCKET=evolution
MINIO_DOCUMENTS_BUCKET=govflow-documents

# ------------------------------------------------------------------------------
# 3. Redis Configuration (Cache e Filas para Evolution API)
# ------------------------------------------------------------------------------
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 4. Evolution API v2 Configuration
# ------------------------------------------------------------------------------
# Tag recomendada: v2.3.7 (sem bloqueio de servidor de licença externo)
EVOLUTION_IMAGE_TAG=v2.3.7
EVOLUTION_PORT=8084
EVOLUTION_API_KEY=GovFlowSuperSecretApiKey2026
EVOLUTION_SERVER_URL=http://localhost:8084

# Configurações operacionais da Evolution API
LOG_LEVEL=ERROR,WARN,INFO
DEL_INSTANCE=false

# ------------------------------------------------------------------------------
# 5. API Gateway (Spring Cloud Gateway)
# ------------------------------------------------------------------------------
GATEWAY_PORT=8080
JWT_SECRET=GovFlowLocalDevJwtSecretKeyChangeMe32b!
CORE_SERVICE_URI=http://stub-core:80
TRANSFEREGOV_SERVICE_URI=http://stub-transferegov:80
WHATSAPP_SERVICE_URI=http://stub-whatsapp:80
AI_SERVICE_URI=http://stub-ai:80
