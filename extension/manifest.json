{
  "manifest_version": 3,
  "name": "GovFlow Copiloto Transferegov",
  "version": "0.1.0",
  "description": "Detecta a tela Incluir Documento Hábil e preenche o formulário oficial com o documento auditado no GovFlow.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:8080/*",
    "https://transferegov.sistema.gov.br/*",
    "https://*.transferegov.sistema.gov.br/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_title": "GovFlow",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://transferegov.sistema.gov.br/*",
        "https://*.transferegov.sistema.gov.br/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content/content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
