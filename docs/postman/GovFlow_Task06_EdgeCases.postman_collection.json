    {
      "name": "02. Ingestão AMQP & Edge Cases de Mensageria",
      "description": "Publicação via RabbitMQ Management API para validar listeners, idempotência e DLQ",
      "item": [
        {
          "name": "03 - RabbitMQ: Publicar Documento Extraído Válido (Tenant A)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var docId = pm.variables.replaceIn('{{$guid}}');",
                  "var eventId = pm.variables.replaceIn('{{$guid}}');",
                  "pm.collectionVariables.set('documentoId', docId);",
                  "pm.variables.set('tempDocId', docId);",
                  "pm.variables.set('tempEventId', eventId);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Mensagem roteada com sucesso no RabbitMQ', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.routed).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "govflow",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "govflow123",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"properties\": {\n    \"delivery_mode\": 2\n  },\n  \"routing_key\": \"documento.extraido\",\n  \"payload\": \"{\\\"eventId\\\": \\\"{{tempEventId}}\\\", \\\"eventType\\\": \\\"DocumentoExtraidoEvent\\\", \\\"version\\\": \\\"1.0.0\\\", \\\"timestamp\\\": \\\"2026-09-17T20:00:00Z\\\", \\\"tenantId\\\": \\\"{{tenantId}}\\\", \\\"correlationId\\\": \\\"{{tempDocId}}\\\", \\\"payload\\\": {\\\"documentoId\\\": \\\"{{tempDocId}}\\\", \\\"s3Bucket\\\": \\\"govflow-bucket\\\", \\\"s3Key\\\": \\\"docs/nf000123.pdf\\\", \\\"nomeArquivoOriginal\\\": \\\"nota_fiscal_servico_000123.pdf\\\", \\\"contentType\\\": \\\"application/pdf\\\", \\\"tamanhoBytes\\\": 204800, \\\"extracao\\\": {\\\"tipo_documento\\\": {\\\"valor\\\": \\\"NOTA_FISCAL_SERVICOS\\\", \\\"confianca\\\": 0.99}, \\\"numero_documento\\\": {\\\"valor\\\": \\\"000123\\\", \\\"confianca\\\": 0.98}, \\\"serie_documento\\\": {\\\"valor\\\": \\\"1\\\", \\\"confianca\\\": 0.95}, \\\"data_emissao\\\": {\\\"valor\\\": \\\"2026-05-10\\\", \\\"confianca\\\": 0.97}, \\\"cnpj_credor\\\": {\\\"valor\\\": \\\"12345678000195\\\", \\\"confianca\\\": 0.99}, \\\"razao_social_credor\\\": {\\\"valor\\\": \\\"Construtora Progresso Ltda\\\", \\\"confianca\\\": 0.98}, \\\"descricao_servico\\\": {\\\"valor\\\": \\\"Reforma e pavimenta\\\\u00e7\\\\u00e3o asf\\\\u00e1ltica\\\", \\\"confianca\\\": 0.95}, \\\"valor_bruto\\\": {\\\"valor\\\": \\\"10000.00\\\", \\\"confianca\\\": 0.99}, \\\"valor_liquido\\\": {\\\"valor\\\": \\\"8900.00\\\", \\\"confianca\\\": 0.99}, \\\"retencoes\\\": [{\\\"tipo\\\": \\\"INSS\\\", \\\"aliquota\\\": 8.0, \\\"valor\\\": 800.0, \\\"confianca\\\": 0.98}, {\\\"tipo\\\": \\\"ISS\\\", \\\"aliquota\\\": 3.0, \\\"valor\\\": 300.0, \\\"confianca\\\": 0.98}]}, \\\"validacao\\\": {\\\"consistente\\\": true, \\\"totalRetencoes\\\": 1100.0, \\\"valorBruto\\\": 10000.0, \\\"valorLiquidoInformado\\\": 8900.0}, \\\"scoreConfianca\\\": 0.98, \\\"boundingBoxes\\\": {\\\"numero_documento\\\": [0.12, 0.45, 0.15, 0.6], \\\"valor_bruto\\\": [0.75, 0.7, 0.78, 0.88]}}}\",\n  \"payload_encoding\": \"string\"\n}"
            },
            "url": {
              "raw": "{{rabbitMqUrl}}/api/exchanges/%2F/govflow.events/publish",
              "host": [
                "{{rabbitMqUrl}}"
              ],
              "path": [
                "api",
                "exchanges",
                "%2F",
                "govflow.events",
                "publish"
              ]
            }
          }
        },
