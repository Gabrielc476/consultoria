    {
      "name": "04. Ciclo de Aprovação Auditada & Edge Cases Fiscais",
      "description": "Validação de tolerância zero, consistência de retenções, DV de CNPJ e transição de estado",
      "item": [
        {
          "name": "11 - PUT Edge Case: Aprovação sem Analista (400 Bad Request)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Retorna 400 Bad Request por ausência do analista responsável', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"analistaId\": null,\n  \"revisao\": {\n    \"tipoDocumento\": \"NOTA_FISCAL_SERVICOS\",\n    \"numeroDocumento\": \"000123\",\n    \"dataEmissao\": \"2026-05-10\",\n    \"cnpjCredor\": \"12.345.678/0001-95\",\n    \"razaoSocialCredor\": \"Construtora Progresso Ltda\",\n    \"valorBruto\": 10000.0,\n    \"valorTotalDeducoes\": 0.0,\n    \"valorLiquido\": 10000.0,\n    \"retencoes\": []\n  },\n  \"observacao\": \"Tentando aprovar sem analista\"\n}"
