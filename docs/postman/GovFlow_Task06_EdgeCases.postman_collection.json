        {
          "name": "13 - PUT Edge Case: Inconsistência Matemática (Bruto - Deduções != Líquido -> 422 com RFC 7807)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Retorna 422 com payload de diagnóstico da Inconsistência Matemática', function () {",
                  "    pm.response.to.have.status(422);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.errorCode).to.eql('INCONSISTENCIA_MATEMATICA_FISCAL');",
                  "    pm.expect(json.tolerancia).to.eql('0.00');",
                  "    pm.expect(json.diferenca).to.eql(500);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"analistaId\": \"{{analistaId}}\",\n  \"revisao\": {\n    \"tipoDocumento\": \"NOTA_FISCAL_SERVICOS\",\n    \"numeroDocumento\": \"000123\",\n    \"dataEmissao\": \"2026-05-10\",\n    \"cnpjCredor\": \"12.345.678/0001-95\",\n    \"razaoSocialCredor\": \"Construtora Progresso Ltda\",\n    \"valorBruto\": 10000.0,\n    \"valorTotalDeducoes\": 1000.0,\n    \"valorLiquido\": 8500.0,\n    \"retencoes\": []\n  },\n  \"observacao\": \"Bruto 10000 - Deducoes 1000 != Liquido 8500\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/documentos/{{documentoId}}/aprovar",
              "host": [
                "{{baseUrl}}"
              ],
