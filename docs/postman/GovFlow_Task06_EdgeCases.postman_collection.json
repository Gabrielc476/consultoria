    {
      "name": "03. Consultas & Blindagem Multi-Tenancy",
      "description": "Testes dos endpoints GET e verificação estrita do isolamento multi-tenant",
      "item": [
        {
          "name": "05 - GET Documento por ID (Happy Path - Tenant A)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code é 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Status é EM_CONFERENCIA e possui scores por campo', function () {",
                  "    pm.expect(json.status).to.eql('EM_CONFERENCIA');",
                  "    pm.expect(json.extracaoSugerida.scoresConfiancaCampos).to.be.an('object');",
                  "    pm.expect(json.boundingBoxes).to.be.an('object');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/documentos/{{documentoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "documentos",
                "{{documentoId}}"
              ]
            }
          }
        },
        {
          "name": "06 - GET Edge Case: Header X-Tenant-Id Ausente (400 Bad Request)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Retorna 400 Bad Request por ausência do Tenant', function () {",
                  "    pm.response.to.have.status(400);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.type).to.include('missing-tenant');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/documentos/{{documentoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "documentos",
                "{{documentoId}}"
