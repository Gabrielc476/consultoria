              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code é 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('tenantId', json.id);",
                  "console.log('Tenant A configurado:', json.id);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var randomSuffix = Math.floor(Math.random() * 8999 + 1000);",
                  "pm.variables.set('cnpjA', '11.222.333/0001-' + (randomSuffix % 90 + 10));"
                ],
                "type": "text/javascript"
              }
            }
